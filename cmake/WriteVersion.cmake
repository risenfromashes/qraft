# Writes qraft_version.hpp with the version, git commit, build date and build
# options. Run at build time so the commit is current; the file is rewritten
# only when its contents change. The date is SOURCE_DATE_EPOCH when set, else
# the commit date, so a rebuild of the same commit gives the same binary.
#
# Inputs: QRAFT_SOURCE_DIR, QRAFT_OUTPUT, QRAFT_VERSION, QRAFT_BUILD_INFO.

set(commit "unknown")
set(dirty "")
set(date "unknown")
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${QRAFT_SOURCE_DIR}/.git")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${QRAFT_SOURCE_DIR}"
                          rev-parse --short=12 HEAD
                  OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE
                  RESULT_VARIABLE git_result ERROR_QUIET)
  if(NOT git_result EQUAL 0)
    set(commit "unknown")
  else()
    # Dirty: a changed tracked file, or a Taskflow checkout at another
    # commit or with changed files (it is compiled in). Other submodules
    # are not part of the build.
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${QRAFT_SOURCE_DIR}"
                            diff --quiet --ignore-submodules=all HEAD --
                    RESULT_VARIABLE dirty_result ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${QRAFT_SOURCE_DIR}"
                            diff --quiet --ignore-submodules=untracked HEAD --
                            external/taskflow
                    RESULT_VARIABLE taskflow_result ERROR_QUIET)
    if(NOT dirty_result EQUAL 0 OR NOT taskflow_result EQUAL 0)
      set(dirty "-dirty")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${QRAFT_SOURCE_DIR}"
                            log -1 --format=%cs
                    OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET)
  endif()
endif()
if(DEFINED ENV{SOURCE_DATE_EPOCH})
  string(TIMESTAMP date "%Y-%m-%d" UTC)
endif()

set(content "#pragma once\n// Generated by cmake/WriteVersion.cmake; do not edit.\n")
string(APPEND content "#define QRAFT_VERSION \"${QRAFT_VERSION}\"\n")
string(APPEND content "#define QRAFT_GIT_COMMIT \"${commit}${dirty}\"\n")
string(APPEND content "#define QRAFT_BUILD_DATE \"${date}\"\n")
string(APPEND content "#define QRAFT_BUILD_INFO \"${QRAFT_BUILD_INFO}\"\n")

set(old "")
if(EXISTS "${QRAFT_OUTPUT}")
  file(READ "${QRAFT_OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${QRAFT_OUTPUT}" "${content}")
endif()
